# Скопируйте в .env и поправьте при необходимости.

# Папка с моделями распознавания речи: ggml-large-v3-turbo.bin (scripts/get_models.sh)
# и ggml-whisper-turbo-ksc2.bin для казахской речи (scripts/get_kazakh_model.sh)
WHISPER_MODELS_DIR=./models

# Языковая модель. qwen3:8b точнее, но ей нужно больше памяти.
LLM_MODEL=qwen3:4b

# Модель для перевода казахских реплик на русский
LLM_MODEL_KK=gemma3:4b

# Если модель уже скачана на этом компьютере, можно не качать её второй раз:
# OLLAMA_MODELS_DIR=/Users/you/.ollama/models

# Настоящая МИС клиники подключается заменой адреса:
# MIS_URL=http://mis.clinic.local

# Название клиники для шапки листа в Word
HATSHY_ORG=
